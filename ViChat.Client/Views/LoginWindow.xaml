<Window x:Class="ViChat.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViChat – Đăng nhập" Width="1000" Height="680" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Ô IP và cổng: viền đỏ khi kết nối lỗi -->
        <Style x:Key="ServerInput" TargetType="TextBox" BasedOn="{StaticResource RoundTextBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionState}" Value="Error">
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                    <Setter Property="Background" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Chấm trạng thái: xám / cam / đỏ -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="#9CA3AF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionState}" Value="Connecting">
                    <Setter Property="Fill" Value="#F59E0B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ConnectionState}" Value="Error">
                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Nút dạng chữ (không nền) -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bong bóng chat trang trí ở panel trái -->
        <Style x:Key="DemoBubble" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="455*"/>
            <ColumnDefinition Width="533*"/>
            <ColumnDefinition Width="12*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= PANEL TRÁI (TÍM) ================= -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}" Padding="48,56" Grid.ColumnSpan="2" Margin="0,0,533,0">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Path Width="30" Height="30" Stretch="Uniform" Stroke="White" StrokeThickness="2"
                          StrokeLineJoin="Round"
                          Data="M21,12 A8,8 0 0 1 9.4,19.1 L4,20.5 L5.4,15.9 A8,8 0 1 1 21,12 Z"/>
                    <TextBlock Text="ViChat" Foreground="White" FontSize="26" FontWeight="Bold"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Bong bóng chat minh họa -->
                <StackPanel DockPanel.Dock="Bottom" MaxWidth="360" HorizontalAlignment="Left">
                    <Border Style="{StaticResource DemoBubble}">
                        <TextBlock Text="Chào bạn, bản báo cáo xong chưa?" FontSize="14"
                                   Foreground="{StaticResource TextBrush}"/>
                    </Border>
                    <Border Style="{StaticResource DemoBubble}" Background="{StaticResource PrimaryDarkBrush}"
                            HorizontalAlignment="Right">
                        <TextBlock Text="Rồi nhé, mình gửi file đây" FontSize="14" Foreground="White"/>
                    </Border>
                    <Border Style="{StaticResource DemoBubble}">
                        <TextBlock Text="ViBot: Mình có thể giúp gì cho bạn?" FontSize="14"
                                   Foreground="{StaticResource TextBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Lời giới thiệu (nằm giữa) -->
                <StackPanel VerticalAlignment="Center" MaxWidth="380" HorizontalAlignment="Left">
                    <TextBlock Text="Nhắn tin nhóm, chia sẻ file, hỏi ViBot" Foreground="White"
                               FontSize="34" FontWeight="Bold" TextWrapping="Wrap" LineHeight="42"/>
                    <TextBlock Text="Kết nối tới server ViChat trong cùng mạng LAN để trò chuyện với cả nhóm."
                               Foreground="{StaticResource PrimaryLightBrush}" FontSize="16"
                               TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="24"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= FORM BÊN PHẢI ================= -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,2,0,-2" Grid.ColumnSpan="2">
            <StackPanel MaxWidth="420" Margin="32,40" VerticalAlignment="Center">

                <TextBlock Text="{Binding FormTitle}" Style="{StaticResource HeadingText}"/>
                <TextBlock Text="{Binding FormSubtitle}" Style="{StaticResource SubText}" Margin="0,6,0,22"/>

                <!-- Hộp thông báo xanh (đăng ký thành công) -->
                <Border Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}"
                        Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1"
                        CornerRadius="14" Padding="16,12" Margin="0,0,0,18">
                    <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" Foreground="#166534" FontSize="13"/>
                </Border>

                <!-- Hộp lỗi đỏ -->
                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                        Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                        CornerRadius="14" Padding="16,12" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                   Foreground="#991B1B" FontSize="13" LineHeight="20"/>
                        <Button Content="Dùng 127.0.0.1 để chạy thử trên máy này"
                                Command="{Binding UseLocalhostCommand}" Margin="0,8,0,0" HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Error">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Khung "Kết nối server" -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="16" Padding="16" Height="148" Width="433">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Kết nối server" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8" Style="{StaticResource StatusDot}"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="13"
                                           Foreground="{StaticResource SubTextBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Địa chỉ IP server" FontSize="13"
                                           Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource ServerInput}"
                                         Text="{Binding ServerIp, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cổng" FontSize="13"
                                           Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource ServerInput}"
                                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="108"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Tên hiển thị: chỉ khi đăng ký -->
                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Tên hiển thị" Style="{StaticResource LabelText}" Margin="0,20,0,6"/>
                    <TextBox Style="{StaticResource RoundTextBox}"
                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Tên đăng nhập -->
                <TextBlock Text="Tên đăng nhập" Style="{StaticResource LabelText}" Margin="0,18,0,6"/>
                <TextBox Style="{StaticResource RoundTextBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Mật khẩu -->
                <TextBlock Text="Mật khẩu" Style="{StaticResource LabelText}" Margin="0,18,0,6"/>
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource RoundPasswordBox}"
                             PasswordChanged="PasswordInput_PasswordChanged"/>

                <!-- Nhập lại mật khẩu: chỉ khi đăng ký -->
                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Nhập lại mật khẩu" Style="{StaticResource LabelText}" Margin="0,18,0,6"/>
                    <PasswordBox x:Name="ConfirmPasswordInput" Style="{StaticResource RoundPasswordBox}"
                                 PasswordChanged="ConfirmPasswordInput_PasswordChanged"/>
                </StackPanel>

                <CheckBox Content="Ghi nhớ địa chỉ server" IsChecked="{Binding RememberServer}"
                          Margin="0,16,0,0" FontSize="14" Foreground="{StaticResource TextBrush}"
                          VerticalContentAlignment="Center"/>

                <Button Content="{Binding SubmitButtonText}" Command="{Binding SubmitCommand}"
                        Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0,22,0,0"/>

                <!-- Chuyển chế độ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <TextBlock Text="{Binding SwitchModeQuestion}" FontSize="14"
                               Foreground="{StaticResource SubTextBrush}" Margin="0,0,6,0"/>
                    <Button Content="{Binding SwitchModeText}" Command="{Binding ToggleModeCommand}"
                            Style="{StaticResource TextButton}" FontSize="14"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>