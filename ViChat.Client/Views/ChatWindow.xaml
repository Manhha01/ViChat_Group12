<Window x:Class="ViChat.Client.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViChat" Width="1200" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Segoe UI Emoji"
        Background="White">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ===== Bảng màu lấy đúng theo bản thiết kế ===== -->
        <SolidColorBrush x:Key="DsPrimary" Color="#6D28D9"/>
        <!-- tím chủ đạo -->
        <SolidColorBrush x:Key="DsPrimarySoft" Color="#F0EDFA"/>
        <!-- nền nút tròn, ViBot -->
        <SolidColorBrush x:Key="DsSelected" Color="#EDEBFB"/>
        <!-- dòng đang chọn -->
        <SolidColorBrush x:Key="DsHover" Color="#F7F6FC"/>
        <!-- rê chuột -->
        <SolidColorBrush x:Key="DsText" Color="#1A1523"/>
        <!-- chữ chính -->
        <SolidColorBrush x:Key="DsSub" Color="#5B6472"/>
        <!-- chữ phụ -->
        <SolidColorBrush x:Key="DsMuted" Color="#9199A6"/>
        <!-- giờ, ghi chú -->
        <SolidColorBrush x:Key="DsBorder" Color="#E5E7EB"/>
        <!-- đường kẻ -->
        <SolidColorBrush x:Key="DsInput" Color="#F2F3F7"/>
        <!-- nền ô tìm kiếm, ô nhập -->
        <SolidColorBrush x:Key="DsBubbleIn" Color="#EEF0F4"/>
        <!-- bong bóng người khác -->
        <SolidColorBrush x:Key="DsChatBg" Color="#FBFBFD"/>
        <!-- nền khung tin nhắn -->
        <SolidColorBrush x:Key="DsOnline" Color="#22C55E"/>
        <!-- chấm online -->

        <!-- Ô nhập không viền (đặt bên trong một Border bo tròn) -->
        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource DsText}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút tròn chỉ có icon (đính kèm, ảnh, emoji, +) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DsPrimarySoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút gửi: tròn 44px nền tím -->
        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource DsPrimary}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5B21B6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút chữ (Đăng xuất, Rời phòng) -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource DsPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab "Phòng" / "Mọi người" -->
        <Style x:Key="TabRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DsSub}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,2" Padding="0,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DsPrimary}"/>
                                <Setter Property="Foreground" Value="{StaticResource DsPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Một dòng ở cột trái: bo góc 12, chọn thì nền tím nhạt -->
        <Style x:Key="RoomItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DsHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DsSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Một dòng phòng / người: [avatar 48] [tên + giờ / dòng phụ] [số chưa đọc] ===== -->
        <DataTemplate x:Key="RoomTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- cột 0: avatar -->
                    <ColumnDefinition Width="*"/>
                    <!-- cột 1: chữ -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- cột 2: số chưa đọc -->
                </Grid.ColumnDefinitions>

                <!-- Avatar + chấm online -->
                <Grid Grid.Column="0" Width="48" Height="48">
                    <Border CornerRadius="24" Background="{Binding AvatarColor}">
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Ellipse Width="12" Height="12" Fill="{StaticResource DsOnline}" Stroke="White" StrokeThickness="2"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1"
                             Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- Tên + giờ (cùng dòng), dòng phụ bên dưới -->
                <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LastTime}" FontSize="12" Margin="8,0,0,0"
                                   VerticalAlignment="Bottom" Foreground="{StaticResource DsSub}"/>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource DsText}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Subtitle}" FontSize="13" Margin="0,2,0,0"
                               Foreground="{StaticResource DsSub}" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- Số tin chưa đọc -->
                <Border Grid.Column="2" Margin="8,0,0,0" MinWidth="20" Height="20" Padding="6,0" CornerRadius="10"
                        VerticalAlignment="Center" Background="{StaticResource DsPrimary}"
                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ===== Một tin nhắn: chữ / file / ảnh; của người khác / của mình / hệ thống ===== -->
        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="0,6">
                <!-- Tin hệ thống: chữ nhỏ ở giữa -->
                <TextBlock x:Name="SystemText" Text="{Binding Content}" Visibility="Collapsed"
                           HorizontalAlignment="Center" FontSize="12" Margin="0,4"
                           Foreground="{StaticResource DsMuted}"/>

                <!-- Tin thường: [avatar 28] [tên / bong bóng / giờ] -->
                <StackPanel x:Name="NormalPanel" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Border x:Name="Avatar" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Bottom"
                            Margin="0,0,9,18" Background="{Binding AvatarColor}">
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel>
                        <TextBlock x:Name="SenderText" Text="{Binding From}" FontSize="12" Margin="4,0,0,3"
                                   Foreground="{StaticResource DsMuted}"/>

                        <!-- Bong bóng: bo 16,16,16,4 (người khác) / 16,16,4,16 (mình) -->
                        <Border x:Name="Bubble" Background="{StaticResource DsBubbleIn}"
                                CornerRadius="16,16,16,4" Padding="14,10" MaxWidth="520" HorizontalAlignment="Left">
                            <!-- Bấm vào bong bóng file/ảnh -> mở file -->
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenCommand}"/>
                            </Border.InputBindings>
                            <StackPanel>
                                <!-- 1) Tin chữ -->
                                <TextBlock x:Name="BubbleText" Text="{Binding Content}" TextWrapping="Wrap"
                                           FontSize="14" LineHeight="20" Foreground="{StaticResource DsText}"/>

                                <!-- 2) Thẻ file: [ô icon 40] [tên / dung lượng / thanh tiến trình] -->
                                <Grid x:Name="FilePanel" Visibility="Collapsed" MinWidth="220">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="FileIcon" Width="40" Height="40" CornerRadius="9" Background="White"
                                            VerticalAlignment="Top">
                                        <Path x:Name="FileIconPath" Width="20" Height="20" Stretch="Uniform"
                                              Stroke="{StaticResource DsPrimary}" StrokeThickness="2"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M14,2 L6,2 A2,2 0 0 0 4,4 L4,20 A2,2 0 0 0 6,22 L18,22 A2,2 0 0 0 20,20 L20,8 Z M14,2 L14,8 L20,8"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="FileNameText" Text="{Binding FileName}" FontSize="13"
                                                   FontWeight="SemiBold" MaxWidth="300" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource DsText}"/>
                                        <TextBlock x:Name="FileSizeText" Text="{Binding FileSizeText}" FontSize="12"
                                                   Margin="0,2,0,0" Foreground="{StaticResource DsSub}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 3) Ảnh: khung bo góc, ảnh cắt vừa khung -->
                                <Border x:Name="ImageView" Visibility="Collapsed" Width="220" Height="150"
                                        CornerRadius="16,16,16,4">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>

                                <!-- Thanh tiến trình mảnh 4px + trạng thái -->
                                <ProgressBar x:Name="Bar" Value="{Binding Progress}" Maximum="100" Height="4"
                                             Margin="0,7,0,0" BorderThickness="0" Background="#DCDFE6"
                                             Foreground="{StaticResource DsPrimary}"
                                             Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="12" Margin="0,4,0,0"
                                           TextWrapping="Wrap" Foreground="{StaticResource DsSub}"
                                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TimeText" Text="{Binding Time}" FontSize="11" Margin="4,3,0,0"
                                   Foreground="{StaticResource DsMuted}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Thứ tự trigger quan trọng: trigger viết SAU đè trigger viết TRƯỚC -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                    <Setter TargetName="SystemText" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="NormalPanel" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <!-- Chat riêng: không cần hiện tên người gửi -->
                <DataTrigger Binding="{Binding IsPrivateChat}" Value="True">
                    <Setter TargetName="SenderText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="file">
                    <Setter TargetName="BubbleText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FilePanel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Bubble" Property="Padding" Value="12"/>
                    <Setter TargetName="Bubble" Property="Cursor" Value="Hand"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="image">
                    <Setter TargetName="BubbleText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FilePanel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Bubble" Property="Padding" Value="12"/>
                    <Setter TargetName="Bubble" Property="Cursor" Value="Hand"/>
                </DataTrigger>
                <!-- Tin của mình: bên phải, nền tím, góc nhọn ở dưới-phải -->
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter TargetName="NormalPanel" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="SenderText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource DsPrimary}"/>
                    <Setter TargetName="Bubble" Property="CornerRadius" Value="16,16,4,16"/>
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="BubbleText" Property="Foreground" Value="White"/>
                    <Setter TargetName="FileIcon" Property="Background" Value="#2EFFFFFF"/>
                    <Setter TargetName="FileIconPath" Property="Stroke" Value="White"/>
                    <Setter TargetName="FileNameText" Property="Foreground" Value="White"/>
                    <Setter TargetName="FileSizeText" Property="Foreground" Value="#BFFFFFFF"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="#BFFFFFFF"/>
                    <Setter TargetName="Bar" Property="Background" Value="#40FFFFFF"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="White"/>
                    <Setter TargetName="TimeText" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="TimeText" Property="Margin" Value="0,3,4,0"/>
                </DataTrigger>
                <!-- Đã có ảnh: ẩn thẻ file, hiện ảnh, bỏ nền bong bóng -->
                <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                    <Setter TargetName="FilePanel" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ImageView" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Bubble" Property="Background" Value="Transparent"/>
                    <Setter TargetName="Bubble" Property="Padding" Value="0"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource DsSub}"/>
                    <Setter TargetName="Bar" Property="Background" Value="#DCDFE6"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource DsPrimary}"/>
                </DataTrigger>
                <!-- Ảnh của mình: góc nhọn bên phải -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasThumbnail}" Value="True"/>
                        <Condition Binding="{Binding IsMine}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ImageView" Property="CornerRadius" Value="16,16,4,16"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== CỘT TRÁI (340px) ===================== -->
        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource DsBorder}" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Logo + nút tạo phòng -->
                <Grid DockPanel.Dock="Top" Margin="18,18,18,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource DsPrimary}"
                              Data="M12,2 C6.5,2 2,6 2,11 C2,13.8 3.4,16.3 5.6,18 L5.6,22 L9.4,19.9 C10.2,20.1 11.1,20.2 12,20.2 C17.5,20.2 22,16.2 22,11.2 C22,6.2 17.5,2 12,2 Z"/>
                        <TextBlock Text="ViChat" FontSize="19" FontWeight="Bold" Margin="9,0,0,0"
                                   Foreground="{StaticResource DsPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Width="36" Height="36" HorizontalAlignment="Right"
                            Background="{StaticResource DsPrimarySoft}"
                            Command="{Binding ToggleCreateRoomCommand}" ToolTip="Tạo phòng mới">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource DsPrimary}"
                              StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M12,5 L12,19 M5,12 L19,12"/>
                    </Button>
                </Grid>

                <!-- Khung tạo phòng (hiện khi bấm +) -->
                <Border DockPanel.Dock="Top" Margin="18,0,18,12" Padding="12" CornerRadius="12"
                        Background="#FAF9FD" BorderBrush="{StaticResource DsBorder}" BorderThickness="1"
                        Visibility="{Binding IsCreatingRoom, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Tên phòng mới" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Foreground="{StaticResource DsText}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource DsInput}" CornerRadius="10" Padding="12,0" Height="40">
                                <TextBox Style="{StaticResource BareTextBox}"
                                         Text="{Binding NewRoomName, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding CreateRoomCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource SendButton}" Width="64" Height="40"
                                    Margin="8,0,0,0" Command="{Binding CreateRoomCommand}">
                                <TextBlock Text="Tạo" Foreground="White" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Ô tìm kiếm: nền xám nhạt, bo 10 -->
                <Border DockPanel.Dock="Top" Margin="18,0,18,8" Height="40" Padding="12,0"
                        Background="{StaticResource DsInput}" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource DsSub}" StrokeThickness="2"
                              VerticalAlignment="Center" Data="M11,4 A7,7 0 1 1 10.99,4 Z M21,21 L16.65,16.65"/>
                        <TextBox Grid.Column="1" Margin="9,0,0,0" Style="{StaticResource BareTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="Tìm bạn bè, nhóm…" FontSize="14"
                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                   Foreground="{StaticResource DsMuted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Tab: Phòng / Mọi người -->
                <Grid DockPanel.Dock="Top" Margin="18,0,18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" GroupName="LeftTab" Content="Phòng"
                                 Style="{StaticResource TabRadio}" IsChecked="{Binding ShowRooms, Mode=TwoWay}"/>
                    <RadioButton Grid.Column="1" GroupName="LeftTab"
                                 Style="{StaticResource TabRadio}" IsChecked="{Binding ShowPeople, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mọi người"/>
                            <Border Margin="6,0,0,0" MinWidth="18" Height="18" Padding="5,0" CornerRadius="9"
                                    Background="{StaticResource DsPrimary}"
                                    Visibility="{Binding HasPrivateUnread, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PrivateUnreadTotal}" Foreground="White" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </Grid>

                <!-- Người dùng hiện tại (dưới cùng) -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DsBorder}" BorderThickness="0,1,0,0"
                        Padding="18,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{Binding UserColor}">
                                <TextBlock Text="{Binding UserInitials}" Foreground="White" FontSize="12"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource DsText}"/>
                                <TextBlock Text="Đang hoạt động" FontSize="12" Foreground="{StaticResource DsOnline}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="Đăng xuất" Style="{StaticResource TextButton}" HorizontalAlignment="Right"
                                Command="{Binding LogoutCommand}"/>
                    </Grid>
                </Border>

                <!-- Danh sách phòng / người (chiếm phần còn lại) -->
                <ListBox ItemsSource="{Binding RoomsView}" SelectedItem="{Binding SelectedRoom}"
                         ItemTemplate="{StaticResource RoomTemplate}"
                         ItemContainerStyle="{StaticResource RoomItemStyle}"
                         Padding="10,4,10,12" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>

        <!-- ===================== KHUNG CHAT (bên phải) ===================== -->
        <DockPanel Grid.Column="1" Background="White">

            <!-- Header: cao 70, avatar 42 + chấm online -->
            <Border DockPanel.Dock="Top" Height="70" Padding="22,0"
                    BorderBrush="{StaticResource DsBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="42" Height="42">
                            <Border CornerRadius="21" Background="{Binding SelectedRoom.AvatarColor, FallbackValue=#9CA3AF}">
                                <TextBlock Text="{Binding SelectedRoom.Initials}" Foreground="White" FontSize="15"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Ellipse Width="11" Height="11" Fill="{StaticResource DsOnline}" Stroke="White" StrokeThickness="2"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Visibility="{Binding SelectedRoom.IsOnline, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                        </Grid>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedRoom.Name, FallbackValue='Chọn một cuộc trò chuyện'}"
                                       FontSize="16" FontWeight="Bold" Foreground="{StaticResource DsText}"/>
                            <TextBlock Text="{Binding SelectedRoom.HeaderSubtitle}" FontSize="12" FontWeight="Medium"
                                       Foreground="{StaticResource DsOnline}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="Rời phòng" Style="{StaticResource TextButton}" HorizontalAlignment="Right"
                            Command="{Binding LeaveRoomCommand}"
                            Visibility="{Binding SelectedRoom.CanLeave, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                </Grid>
            </Border>

            <!-- Thanh nhập: [📎] [🖼] [ ô nhập ... 😊 ] [Gửi] -->
            <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{StaticResource DsBorder}" BorderThickness="0,1,0,0">
                <Grid IsEnabled="{Binding SelectedRoom.IsJoined, FallbackValue=False}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Đính kèm file -->
                    <Button Grid.Column="0" Style="{StaticResource IconButton}" Command="{Binding AttachFileCommand}"
                            ToolTip="Gửi file">
                        <Path Width="21" Height="21" Stretch="Uniform" Stroke="{StaticResource DsPrimary}"
                              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M21.44,11.05 L12.25,20.24 A6,6 0 0 1 3.76,11.75 L12.95,2.56 A4,4 0 0 1 18.61,8.22 L9.41,17.41 A2,2 0 0 1 6.58,14.58 L15.07,6.1"/>
                    </Button>

                    <!-- Gửi ảnh -->
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="2,0,10,0"
                            Command="{Binding AttachImageCommand}" ToolTip="Gửi ảnh">
                        <Path Width="21" Height="21" Stretch="Uniform" Stroke="{StaticResource DsPrimary}"
                              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M5,3 L19,3 A2,2 0 0 1 21,5 L21,19 A2,2 0 0 1 19,21 L5,21 A2,2 0 0 1 3,19 L3,5 A2,2 0 0 1 5,3 Z M21,15 L16,10 L5,21 M8.5,7 A1.5,1.5 0 1 1 8.49,7 Z"/>
                    </Button>

                    <!-- Ô nhập bo 22, emoji nằm BÊN TRONG ô (giống bản mẫu) -->
                    <Border Grid.Column="2" Background="{StaticResource DsInput}" CornerRadius="22"
                            Height="44" Padding="16,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MessageBox" Style="{StaticResource BareTextBox}"
                                     Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Nhập tin nhắn…" FontSize="14" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Foreground="{StaticResource DsMuted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button x:Name="EmojiButton" Grid.Column="1" Style="{StaticResource IconButton}"
                                    Width="32" Height="32" Command="{Binding OpenEmojiCommand}" ToolTip="Chèn emoji">
                                <Path Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource DsSub}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M12,2 A10,10 0 1 1 11.99,2 Z M8,14 Q12,18 16,14 M9,9 L9.01,9 M15,9 L15.01,9"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Bảng emoji nổi lên trên nút emoji -->
                    <Popup IsOpen="{Binding IsEmojiOpen, Mode=TwoWay}" StaysOpen="False"
                           PlacementTarget="{Binding ElementName=EmojiButton}" Placement="Top"
                           HorizontalOffset="-270" VerticalOffset="-8" AllowsTransparency="True">
                        <Border Background="White" CornerRadius="16" Padding="10" Margin="8"
                                BorderBrush="{StaticResource DsBorder}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.15"/>
                            </Border.Effect>
                            <ItemsControl ItemsSource="{Binding Emojis}" Width="304">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Width="38" Height="38" FontSize="20"
                                                FontFamily="Segoe UI Emoji" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0"
                                                Command="{Binding DataContext.InsertEmojiCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>

                    <!-- Nút gửi 44px -->
                    <Button Grid.Column="3" Style="{StaticResource SendButton}" Margin="10,0,0,0"
                            Command="{Binding SendMessageCommand}" ToolTip="Gửi">
                        <Path Width="20" Height="20" Stretch="Uniform" Stroke="White" StrokeThickness="2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M22,2 L11,13 M22,2 L15,22 L11,13 L2,9 Z"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Thông báo lỗi (tự ẩn sau 4 giây) -->
            <Border DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="20,0,20,10" Padding="14,8"
                    Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="12"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Notice}" Foreground="#991B1B" FontSize="13"/>
            </Border>

            <!-- Khung tin nhắn: nền #FBFBFD, lề 24/22 -->
            <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource DsChatBg}" Padding="24,16">
                <ItemsControl ItemsSource="{Binding CurrentMessages}" ItemTemplate="{StaticResource MessageTemplate}"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
