<Window x:Class="ViChat.Client.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="ViChat" Width="1200" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Nút tròn nền tím nhạt (nút +, nút đính kèm) -->
        <Style x:Key="SoftCircleButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource PrimaryLightBrush}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDD6FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút dạng chữ -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Một dòng phòng: bo góc, chọn thì nền tím nhạt -->
        <Style x:Key="RoomItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F4F3F8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nội dung một dòng phòng -->
        <DataTemplate x:Key="RoomTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="23" Background="{Binding AvatarColor}">
                    <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,2,0,0"
                               Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastTime}" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{StaticResource SubTextBrush}"/>
                    <Border Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource PrimaryBrush}" CornerRadius="10"
                            MinWidth="20" Height="20" Padding="6,0" Margin="0,4,0,0" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Một tin nhắn: chữ / thẻ file / ảnh; của người khác / của mình / hệ thống -->
        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="0,4">
                <TextBlock x:Name="SystemText" Text="{Binding Content}" Visibility="Collapsed"
                           HorizontalAlignment="Center" FontSize="12" Margin="0,6"
                           Foreground="{StaticResource SubTextBrush}"/>

             

                <StackPanel x:Name="NormalPanel" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Border x:Name="Avatar" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Bottom"
                            Margin="0,0,8,18" Background="{Binding AvatarColor}">
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="SenderText" Text="{Binding From}" FontSize="12" Margin="12,0,0,3"
                                   Foreground="{StaticResource SubTextBrush}"/>
                        <Border x:Name="Bubble" Background="#EEEEF3" CornerRadius="18" Padding="14,9"
                                MaxWidth="460" HorizontalAlignment="Left">
                            <!-- Bấm vào bong bóng file/ảnh -> mở file (tin chữ thì không làm gì) -->
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenCommand}"/>
                            </Border.InputBindings>
                            <StackPanel>
                                <!-- 1) Tin chữ -->
                                <emoji:TextBlock x:Name="BubbleText" Text="{Binding Content}" TextWrapping="Wrap"
                                                 FontSize="14" Foreground="{StaticResource TextBrush}"/>

                                <!-- 2) Thẻ file: biểu tượng + tên + dung lượng -->
                                <Grid x:Name="FilePanel" Visibility="Collapsed" MinWidth="230">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="White">
                                        <Path Width="18" Height="18" Stretch="Uniform"
                                              Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                                              StrokeLineJoin="Round"
                                              Data="M6,2 L14,2 L20,8 L20,22 L6,22 Z M14,2 L14,8 L20,8"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="FileNameText" Text="{Binding FileName}" FontSize="14"
                                                   FontWeight="SemiBold" MaxWidth="300" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock x:Name="FileSizeText" Text="{Binding FileSizeText}" FontSize="12"
                                                   Foreground="{StaticResource SubTextBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 3) Ảnh (hiện khi đã có ảnh thu nhỏ) -->
                                <Image x:Name="ImageView" Source="{Binding Thumbnail}" Visibility="Collapsed"
                                       MaxWidth="280" MaxHeight="280" Stretch="Uniform"/>

                                <!-- Thanh tiến trình + trạng thái (tin chữ luôn ẩn) -->
                                <ProgressBar x:Name="Bar" Value="{Binding Progress}" Maximum="100" Height="6"
                                             Margin="0,8,0,0" BorderThickness="0" Background="#E5E7EB"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="12" Margin="0,4,0,0"
                                           TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}"
                                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TimeText" Text="{Binding Time}" FontSize="11" Margin="12,3,0,0"
                                   Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <!-- Thứ tự trigger quan trọng: trigger viết SAU sẽ đè trigger viết TRƯỚC -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                    <Setter TargetName="SystemText" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="NormalPanel" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="file">
                    <Setter TargetName="BubbleText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FilePanel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Bubble" Property="Cursor" Value="Hand"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="image">
                    <Setter TargetName="BubbleText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FilePanel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Bubble" Property="Cursor" Value="Hand"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter TargetName="NormalPanel" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="SenderText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="BubbleText" Property="Foreground" Value="White"/>
                    <Setter TargetName="FileNameText" Property="Foreground" Value="White"/>
                    <Setter TargetName="FileSizeText" Property="Foreground" Value="#E9D5FF"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="#E9D5FF"/>
                    <Setter TargetName="Bar" Property="Background" Value="#66FFFFFF"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="White"/>
                    <Setter TargetName="TimeText" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="TimeText" Property="Margin" Value="0,3,12,0"/>
                </DataTrigger>
                <!-- Đã có ảnh: bỏ thẻ file, hiện ảnh, bỏ nền bong bóng -->
                <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                    <Setter TargetName="FilePanel" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ImageView" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Bubble" Property="Background" Value="Transparent"/>
                    <Setter TargetName="Bubble" Property="Padding" Value="0"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource SubTextBrush}"/>
                    <Setter TargetName="Bar" Property="Background" Value="#E5E7EB"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== CỘT TRÁI ===================== -->
        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,20,16,16">

                <!-- Logo + nút tạo phòng -->
                <Grid DockPanel.Dock="Top" Margin="4,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="26" Height="26" Stretch="Uniform" Stroke="{StaticResource PrimaryBrush}"
                              StrokeThickness="2" StrokeLineJoin="Round"
                              Data="M21,12 A8,8 0 0 1 9.4,19.1 L4,20.5 L5.4,15.9 A8,8 0 1 1 21,12 Z"/>
                        <TextBlock Text="ViChat" FontSize="22" FontWeight="Bold" Margin="8,0,0,0"
                                   Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource SoftCircleButton}" HorizontalAlignment="Right"
                            Command="{Binding ToggleCreateRoomCommand}" ToolTip="Tạo phòng mới">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource PrimaryBrush}"
                              StrokeThickness="2" Data="M12,5 L12,19 M5,12 L19,12"/>
                    </Button>
                </Grid>

                <!-- Khung tạo phòng (hiện khi bấm +) -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12" CornerRadius="14"
                        Background="#FAF9FD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Visibility="{Binding IsCreatingRoom, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Tên phòng mới" Style="{StaticResource LabelText}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource RoundTextBox}"
                                     Text="{Binding NewRoomName, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CreateRoomCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="Tạo" Style="{StaticResource PrimaryButton}"
                                    Width="72" Height="46" Margin="8,0,0,0" Command="{Binding CreateRoomCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Ô tìm kiếm -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox Style="{StaticResource RoundTextBox}" Padding="42,0,16,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Path Width="15" Height="15" Stretch="Uniform" Margin="18,0,0,0" IsHitTestVisible="False"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Stroke="{StaticResource SubTextBrush}" StrokeThickness="2"
                          Data="M11,4 A7,7 0 1 1 10.99,4 Z M20,20 L16,16"/>
                    <TextBlock Text="Tìm phòng..." Margin="44,0,0,0" FontSize="15" IsHitTestVisible="False"
                               VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Người dùng hiện tại (dưới cùng) -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Padding="4,14,4,0" Margin="0,8,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{Binding UserColor}">
                                <TextBlock Text="{Binding UserInitials}" Foreground="White" FontSize="12"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Đang hoạt động" FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="Đăng xuất" Style="{StaticResource TextButton}" HorizontalAlignment="Right"
                                Command="{Binding LogoutCommand}"/>
                    </Grid>
                </Border>

                <!-- Danh sách phòng (chiếm phần còn lại) -->
                <ListBox ItemsSource="{Binding RoomsView}" SelectedItem="{Binding SelectedRoom}"
                         ItemTemplate="{StaticResource RoomTemplate}"
                         ItemContainerStyle="{StaticResource RoomItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>

        <!-- ===================== KHUNG PHẢI ===================== -->
        <DockPanel Grid.Column="1">

            <!-- Header phòng -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="22"
                                Background="{Binding SelectedRoom.AvatarColor, FallbackValue=#9CA3AF}">
                            <TextBlock Text="{Binding SelectedRoom.Initials}" Foreground="White" FontSize="14"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedRoom.Name, FallbackValue='Chọn một phòng'}"
                                       FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{Binding SelectedRoom.MemberCount, StringFormat='{}{0} người trong phòng'}"
                                       FontSize="13" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="Rời phòng" Style="{StaticResource TextButton}" HorizontalAlignment="Right"
                            Command="{Binding LeaveRoomCommand}"
                            Visibility="{Binding SelectedRoom.IsJoined, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                </Grid>
            </Border>

            <!-- Thanh nhập tin -->
            <!-- Thanh nhập tin: [📎] [🖼] [ô nhập] [😊] [Gửi] -->
            <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="20,14">
                <Grid IsEnabled="{Binding SelectedRoom.IsJoined, FallbackValue=False}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nút đính kèm file -->
                    <Button Grid.Column="0" Style="{StaticResource SoftCircleButton}" Width="46" Height="46"
                            Margin="0,0,8,0" Command="{Binding AttachFileCommand}" ToolTip="Gửi file">
                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource PrimaryBrush}"
                              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M21,11 L12,20 A6,6 0 0 1 3.5,11.5 L12,3 A4,4 0 0 1 17.7,8.7 L9.2,17.2 A2,2 0 0 1 6.4,14.4 L14.5,6.3"/>
                    </Button>

                    <!-- MỚI: nút gửi ảnh -->
                    <Button Grid.Column="1" Style="{StaticResource SoftCircleButton}" Width="46" Height="46"
                            Margin="0,0,12,0" Command="{Binding AttachImageCommand}" ToolTip="Gửi ảnh">
                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource PrimaryBrush}"
                              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M3,5 L21,5 L21,19 L3,19 Z M3,16 L8,11 L13,16 M12,15 L15,12 L21,18 M16.5,8.5 A1.5,1.5 0 1 1 16.49,8.5 Z"/>
                    </Button>

                    <!-- Ô nhập tin -->
                    <Grid Grid.Column="2">
                        <TextBox x:Name="MessageBox" Style="{StaticResource RoundTextBox}"
                                 FontFamily="Segoe UI, Segoe UI Emoji"
                                 Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Nhập tin nhắn..." Margin="18,0,0,0" FontSize="15" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- MỚI: nút emoji + bảng chọn emoji -->
                    <Button x:Name="EmojiButton" Grid.Column="3" Style="{StaticResource SoftCircleButton}"
                            Width="46" Height="46" Margin="12,0,0,0"
                            Command="{Binding OpenEmojiCommand}" ToolTip="Chèn emoji">
                        <Path Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource PrimaryBrush}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M12,3 A9,9 0 1 1 11.99,3 Z M8,14 Q12,18 16,14 M9,9.5 L9,10 M15,9.5 L15,10"/>
                    </Button>

                    <!-- Popup: nổi lên phía trên nút emoji, bấm ra ngoài thì tự đóng (StaysOpen=False) -->
                    <Popup IsOpen="{Binding IsEmojiOpen, Mode=TwoWay}" StaysOpen="False"
                           PlacementTarget="{Binding ElementName=EmojiButton}" Placement="Top"
                           HorizontalOffset="-250" VerticalOffset="-8" AllowsTransparency="True">
                        <Border Background="White" CornerRadius="16" Padding="10" Margin="8"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.15"/>
                            </Border.Effect>
                            <ItemsControl ItemsSource="{Binding Emojis}" Width="304">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                        <!-- xếp emoji thành nhiều hàng -->
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Mỗi emoji là một nút; gọi InsertEmojiCommand của ViewModel -->
                                        <Button Width="38" Height="38" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0"
                                                Command="{Binding DataContext.InsertEmojiCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <emoji:TextBlock Text="{Binding}" FontSize="20"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>

                    <!-- Nút gửi -->
                    <Button Grid.Column="4" Style="{StaticResource CircleButton}" Margin="12,0,0,0"
                            Command="{Binding SendMessageCommand}" ToolTip="Gửi">
                        <Path Width="18" Height="18" Stretch="Uniform" Fill="White"
                              Data="M3,11 L21,3 L13,21 L11,13 Z"/>
                    </Button>
                </Grid>
            </Border>
            <!-- Thông báo lỗi (tự ẩn sau 4 giây) -->
            <Border DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="20,0,20,10" Padding="14,8"
                    Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="12"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Notice}" Foreground="#991B1B" FontSize="13"/>
            </Border>

            <!-- Khung tin nhắn -->
            <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <ItemsControl ItemsSource="{Binding CurrentMessages}" ItemTemplate="{StaticResource MessageTemplate}"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>