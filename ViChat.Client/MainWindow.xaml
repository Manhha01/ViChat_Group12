<Window x:Class="ViChat.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViChat - thử kết nối" Height="560" Width="520"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="32">
        <TextBlock Text="Thử kết nối server" Style="{StaticResource HeadingText}"/>
        <TextBlock Text="Bước 1: kiểm tra style và NetworkClient" Style="{StaticResource SubText}" Margin="0,4,0,20"/>

        <TextBlock Text="Địa chỉ IP server" Style="{StaticResource LabelText}"/>
        <TextBox x:Name="IpBox" Style="{StaticResource RoundTextBox}"/>

        <TextBlock Text="Tên hiển thị" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
        <TextBox x:Name="NameBox" Style="{StaticResource RoundTextBox}"/>

        <Button x:Name="ConnectButton" Content="Kết nối" Style="{StaticResource PrimaryButton}"
                Margin="0,20,0,0" Click="ConnectButton_Click"/>

        <TextBlock x:Name="StatusText" Style="{StaticResource SubText}" Margin="0,12,0,0"/>

        <TextBlock Text="Gói tin nhận được" Style="{StaticResource LabelText}" Margin="0,16,0,6"/>
        <ListBox x:Name="LogList" Height="140" BorderBrush="{StaticResource BorderBrush}"/>
    </StackPanel>
</Window>